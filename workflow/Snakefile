import os
import shutil
configfile: "config/config.yaml"


As= [config['samples']['inparanoid'][config["set"]]["Aproteins"]]
Bs= [config['samples']['inparanoid'][config["set"]]["Bproteins"]]
SAMPLES = list(set([*As,*Bs]))
As_basenames= [os.path.basename(A) for A in As]
Bs_basenames= [os.path.basename(B) for B in Bs]
PAIRS = list(map(lambda pair: "-".join(pair),list(zip(As_basenames,Bs_basenames))))
SETS=[config["set"]]


shutil.copy("config/input/mmseqs/Reference_proteome_Ae_aegypti_LVP_AGWG_UP000008820_7159.fasta", "config/input/mmseqs/queries/Reference_proteome_Ae_aegypti_LVP_AGWG_UP000008820_7159.fasta")
shutil.copy("config/input/mmseqs/Reference_proteome_D_melanogaster_UP000000803_7227.fasta", "config/input/mmseqs/targets/Reference_proteome_D_melanogaster_UP000000803_7227.fasta")
shutil.copy("config/input/mmseqs/Reference_proteome_Human_uniprot_9606_reviewed_canonical_isoforms_191008.fasta", "config/input/mmseqs/targets/Reference_proteome_Human_uniprot_9606_reviewed_canonical_isoforms_191008.fasta")
shutil.copy("config/input/mmseqs/Reference_proteome_Mouse_UP000000589_10090.fasta", "config/input/mmseqs/targets/Reference_proteome_Mouse_UP000000589_10090.fasta")

rule all:
    input:
        "results/combine_mmseqs_and_inparanoid/mmseqs_inparanoid_one2one.csv",
        



rule mmseqs_easy_rbh:
    input:
        Aproteins=lambda wildcards: f"config/input/mmseqs/queries/{wildcards.pair.split('-')[0].replace('.fasta', '').replace('.orthotype', '')}.fasta",
        Bproteins=lambda wildcards: f"config/input/mmseqs/targets/{wildcards.pair.split('-')[1].replace('.fasta', '').replace('.orthotype', '')}.fasta"
    params:
        e = config["mmseqs"]["evalue"]
    output:
        "results/mmseqs_easy_rbh/{pair}.txt"
    container:
        "https://depot.galaxyproject.org/singularity/mmseqs2:15.6f452--pl5321h6a68c12_3"
    shell:
        """
        mmseqs easy-rbh {input.Aproteins} {input.Bproteins} {output} tmp -e {params.e}  --format-output query,target,fident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits,qcov,tcov
        """

rule mmseqs_postprocessing:
    input:
        lambda wildcards: f"results/mmseqs_easy_rbh/{wildcards.pair.replace('.fasta', '').replace('.orthotype', '')}.txt"
    output:
        "results/mmseqs_postprocessing/{pair}.orthotype.txt"
    conda:
        workflow.source_path("envs/env.yaml")
    params:
        _helper = workflow.source_path("scripts/postprocess_mmseqs_output.py")
    shell:
        """
        python {params._helper} {input} {output}
        """

rule inparanoid:
    input:
        SAMPLES
    output:
        "results/inparanoid/{set}/SQLtable.{pair}"
    container:
        "docker://sonnhammer/inparanoid:singularity"
    shell:
        """
        bash /runSingularity.sh
        """

rule inparanoid_postprocessing:
    input:
        "results/inparanoid/{set}/SQLtable.{pair}"
    output:
        "results/inparanoid_postprocessing/{set}/orthotype.SQLtable.{pair}.csv"
    params:
        _helper = workflow.source_path("scripts/postprocess_inparanoid_output.py")
    conda:
        workflow.source_path("envs/env.yaml")
    shell:
        """
        python {params._helper} {input} {output}
        """

rule get_mmseqs_not_in_inparanoid:
    input:
        inparanoid = "results/inparanoid_postprocessing/{set}/orthotype.SQLtable.{pair}.csv",
        mmseqs = lambda wildcards: f"results/mmseqs_postprocessing/{wildcards.pair.replace('.fasta', '').replace('.orthotype', '')}.orthotype.txt"
    output:
        "results/get_mmseqs_not_in_inparanoid/{set}/{pair}_mmseqs_not_in_inparanoid.orthotype.txt"
    params:
        _helper = workflow.source_path("scripts/get_mmseqs_not_in_inparanoid.py")
    conda:
        workflow.source_path("envs/env.yaml")
    shell:
        """
        python {params._helper} {input.inparanoid} {input.mmseqs} --output {output}
        """

rule combine_mmseqs_and_inparanoid:
    input:
        [*list(expand("results/get_mmseqs_not_in_inparanoid/{set}/{pair}_mmseqs_not_in_inparanoid.orthotype.txt",zip,set=SETS,pair=PAIRS)),
        *list(expand("results/inparanoid_postprocessing/{set}/orthotype.SQLtable.{pair}.csv",zip,set=SETS,pair=PAIRS))]
    output:
        "results/combine_mmseqs_and_inparanoid/mmseqs_inparanoid_one2one.csv"
    shell:
        """
        read -r mmseqs_output inparanoid_output <<< '{input}'
        grep "1\\:1" $mmseqs_output | cut -d"," -f1,2 > tmp1
        grep "1\\:1" $inparanoid_output | cut -d"," -f7,8 > tmp2
        echo "uniprot_id_Aedes_aegypti,uniprot_id_Drosophila_melanogaster" > {output}
        cat tmp1 tmp2 >> {output}
        rm tmp1 tmp2
        """